/* 个人中心 */
.h1-sm {
  font-size: 46rpx;
}

.me {
  margin-top: 32rpx;
  padding: 40rpx;
  display: flex;
  align-items: center;
}

.ava {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: var(--green-soft);
  color: var(--green-deep);
  font-size: 38rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.me-info {
  margin-left: 28rpx;
}

.name {
  font-size: 33rpx;
  font-weight: 700;
  letter-spacing: -0.4rpx;
}

.role {
  display: inline-block;
  font-size: 19rpx;
  font-weight: 700;
  color: var(--green-deep);
  background: var(--green-soft);
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  margin-top: 14rpx;
  letter-spacing: 1rpx;
}

.nums {
  display: flex;
  margin-top: 24rpx;
  background: var(--card);
  border-radius: 36rpx;
  padding: 32rpx 0;
  box-shadow: 0 10rpx 32rpx rgba(58, 50, 36, 0.055);
}

.num-item {
  flex: 1;
  text-align: center;
  position: relative;
}

.num-item + .num-item::before {
  content: "";
  position: absolute;
  left: 0;
  top: 8rpx;
  bottom: 8rpx;
  width: 2rpx;
  background: var(--line);
}

.num-item .n {
  display: block;
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.num-item .s {
  display: block;
  font-size: 21rpx;
  color: var(--muted);
  margin-top: 8rpx;
}

.menu {
  background: var(--card);
  border-radius: 36rpx;
  margin-top: 24rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 32rpx rgba(58, 50, 36, 0.055);
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid #F6F2E9;
}

.row:last-child {
  border-bottom: none;
}

.row-hover {
  background: #FAF8F3;
}

.row .l {
  display: flex;
  align-items: center;
  font-size: 25rpx;
}

.ico {
  width: 54rpx;
  height: 54rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
}

.ico-img {
  width: 30rpx;
  height: 30rpx;
}

.arr {
  color: #CFCBC0;
  font-size: 26rpx;
}

.foot-note {
  text-align: center;
  font-size: 20rpx;
  color: #B4AE9F;
  letter-spacing: 1.2rpx;
  margin-top: 44rpx;
}
